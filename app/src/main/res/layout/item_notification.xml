<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:orientation="horizontal">
    <View android:id="@+id/unreadDot" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginTop="6dp" android:background="@drawable/bg_badge_dot"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
        <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold"/>
        <TextView android:id="@+id/tvMessage" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
