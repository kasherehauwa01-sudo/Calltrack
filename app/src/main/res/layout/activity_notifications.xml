<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <ImageButton android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_back" android:background="@drawable/bg_input"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Уведомления" android:textStyle="bold" android:textSize="20sp" android:paddingStart="12dp" android:paddingTop="8dp"/>
        <Button android:id="@+id/btnMarkAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Отметить все как прочитанные"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/filterAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Все"/>
        <Button android:id="@+id/filterUnread" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Непрочитанные"/>
        <Button android:id="@+id/filterReminders" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Напоминания"/>
        <Button android:id="@+id/filterErrors" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ошибки"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
